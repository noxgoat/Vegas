# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Pasta do banco SQLite e dos arquivos originais coletados
JURIS_DATA_DIR=./data
# Endereço do servidor (mantenha 127.0.0.1 para uso só no seu computador)
JURIS_HOST=127.0.0.1
JURIS_PORT=8000
# Token de acesso: se definido, a interface pede o token e a API exige o cabeçalho X-App-Token.
# Obrigatório se o servidor for exposto na rede.
JURIS_APP_TOKEN=
# Domínios que os conectores podem acessar (escopo São Paulo: TJSP e TRT-15)
JURIS_ALLOWED_DOMAINS=tjsp.jus.br,trt15.jus.br,jt.jus.br,comunicaapi.pje.jus.br,comunica.pje.jus.br
# Identificação enviada aos portais
JURIS_USER_AGENT=JurisBusca/1.0 (pesquisa juridica pessoal; uso nao comercial)
JURIS_MAX_DOWNLOAD_MB=50
# Proxy HTTP opcional para acessar as fontes (ex.: saída por IP no Brasil, exigida pelo DJEN).
# Use apenas um proxy seu ou contratado. Formato: http://host:porta ou http://usuario:senha@host:porta
JURIS_PROXY=
# OCR (Tesseract com idioma português)
JURIS_OCR=1
JURIS_OCR_LANG=por
JURIS_OCR_MIN_CONF=60
# Agendador de coletas periódicas (1 = ligado)
JURIS_AGENDADOR=1
# Retenção (dias) do histórico de pesquisas e dos logs de coleta
JURIS_RETENCAO_PESQUISAS_DIAS=180
JURIS_RETENCAO_LOGS_DIAS=365
# Tamanho do contexto exibido antes/depois de cada ocorrência
JURIS_CONTEXTO_TRECHO=220
# Resumo por IA (opcional). Sem chave, o recurso fica desativado.
ANTHROPIC_API_KEY=
JURIS_MODELO_IA=claude-opus-5-5
